# Environment configuration for Kriyamaan Rebuild

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector)
# Async URI for FastAPI / application runtime
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kriyaman
# Sync URI for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/kriyaman

# Redis Cache (Optional / Fail-safe cache behind CachePort)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300

# LLM Provider (Google Gemini)
# LLM Provider & Model Routing (LiteLLM Gateway)
LLM_ENABLED=true
GOOGLE_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF=1.0

# Logical Role Models
PLANNER_MODEL=groq/openai/gpt-oss-20b
JUDGE_MODEL=groq/openai/gpt-oss-20b
GENERATOR_MODEL=gemini/gemini-2.5-flash

# Guardrails Configuration
PII_MODE=mask
PROMPT_INJECTION_MODE=reject
MAX_QUERY_LENGTH=2000
MAX_EVIDENCE_LENGTH=20000
GUARDRAIL_FAILURE_BEHAVIOR=reject
TRACE_RAW_PROMPTS=false

# Embeddings (Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Web Search Provider (Optional)
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=

# Execution Budgets (Defaults)
MAX_RETRIEVAL_ITERATIONS=3
MAX_TOOL_CALLS=3
MAX_LATENCY_MS=30000
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=2000
MAX_ESTIMATED_COST_USD=0.25

# Observability (Langfuse - deferred to Phase 6; no-op baseline)
OBSERVABILITY_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

